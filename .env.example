# DLLM Finals — environment example
# Copy to .env for local development. NEVER commit the real .env file.

# HTTP server binding. Loopback only by default.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8788

# CloakBrowser / CDP endpoint. Port 9223 is the DLLM historical convention.
# This value is a configuration default, NOT a verified active endpoint.
# No LP Agent API key and no Fabriq credential are required.
CDP_ENDPOINT=http://127.0.0.1:9223

# CDP connect timeout in milliseconds.
CDP_CONNECT_TIMEOUT_MS=15000
